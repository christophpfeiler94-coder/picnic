# Copy this file to .env and fill it in.

# Random text, at least 16 characters. It encrypts your login cookie.
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Picnic country: de (Germany), nl, be or fr.
PICNIC_COUNTRY=de

# Port for the local server.
PORT=3000
